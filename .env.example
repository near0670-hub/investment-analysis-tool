# =====================================================
# Investment Analysis Tool - 환경변수 예시
# =====================================================
# 이 파일을 .env로 복사한 뒤 API 키를 채워넣으세요.
#   cp .env.example .env
#
# .env 파일은 .gitignore에 포함되어 있어 커밋되지 않습니다.
# 앱은 python-dotenv 또는 OS 환경변수로 자동 로드합니다.

# -----------------------------------------------------
# DART (한국 공시) - 필수 (한국 종목 분석 시)
# 발급: https://opendart.fss.or.kr  (30초, 무료)
# -----------------------------------------------------
DART_API_KEY=

# -----------------------------------------------------
# FRED (매크로 데이터) - 필수 (Macro Context 사이드바)
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html  (무료)
# -----------------------------------------------------
FRED_API_KEY=

# -----------------------------------------------------
# Phase 3 (LLM, 옵션)
# -----------------------------------------------------
# ANTHROPIC_API_KEY=
